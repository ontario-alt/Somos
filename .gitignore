# Vantagepoint exports and derived data are real client financial data --
# never committed. data/raw is a config-driven pointer at your local
# OneDrive sync folder; data/processed and the warehouse are regenerated
# by etl/build_warehouse.py.
data/raw/*
data/processed/*
!data/raw/.gitkeep
!data/processed/.gitkeep
*.duckdb

# Project Pricing tool -- saved pricing projects are real client budget
# data, never committed.
data/pricing/*
!data/pricing/.gitkeep

# Real employee names -- hand-maintained locally (etl/parse_employee_targets.py
# auto-generates a starter the first time build_warehouse.py runs if this
# is missing, so nothing is lost by not committing it).
reference/employee_targets.csv

__pycache__/
*.pyc
.venv/
venv/
.streamlit/secrets.toml
